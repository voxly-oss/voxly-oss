# ═══════════════════════════════════════════
# Voxly — Environment Configuration
# ═══════════════════════════════════════════
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ─── Database ───
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/projectvoice

# ─── JWT Authentication ───
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ─── AI — Gemini (Primary, Free Tier) ───
# Get your key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSy-xxx

# ─── AI — Anthropic Claude (Optional / Paid) ───
# Get your key: https://console.anthropic.com/
# ANTHROPIC_API_KEY=sk-ant-api03-xxx

# ─── GitHub ───
# Create a token: https://github.com/settings/tokens
GITHUB_TOKEN=ghp_xxx

# ─── WhatsApp (Twilio) ───
# Sign up: https://www.twilio.com/
TWILIO_ACCOUNT_SID=ACxxx
TWILIO_AUTH_TOKEN=xxx
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# ─── Redis ───
REDIS_URL=redis://localhost:6379

# ─── Stripe (Optional) ───
# STRIPE_SECRET_KEY=sk_test_xxx

# ─── Razorpay (Optional) ───
# RAZORPAY_KEY_ID=rzp_test_xxx
# RAZORPAY_KEY_SECRET=xxx

# ─── Telegram (Optional) ───
# Message @BotFather on Telegram → /newbot → copy token
# TELEGRAM_BOT_TOKEN=123456789:AAH_xxx
# TELEGRAM_WEBHOOK_SECRET=random-string-for-webhook-auth

# ─── Super Admin (Command Center) ───
# SUPER_ADMIN_EMAIL=owner@yourdomain.com
# SUPER_ADMIN_SECRET=generate-a-64-char-hex-secret

# ─── Frontend ───
NEXT_PUBLIC_API_URL=http://localhost:8000

# ─── App Settings ───
DEBUG=true
